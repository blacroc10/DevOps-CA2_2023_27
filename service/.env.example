TAVILY_API_KEY=tvly-your-key-here
GROQ_API_KEY=gsk-your-key-here

# Optional tuning
LLAMA_PROVIDER=groq
LLAMA_MODEL=llama-3.1-8b-instant
REQUEST_TIMEOUT_SECONDS=20
EXTERNAL_RETRY_COUNT=2
RETRY_BACKOFF_SECONDS=0.5
TAVILY_SEARCH_DEPTH=advanced
TAVILY_RESULTS_PER_CLAIM=5
MAX_CLAIMS=5
GRAPH_CONFIDENCE_K=2.5
DIRECT_EVIDENCE_HOP_DISTANCE=1
RELATIONSHIP_SIMILARITY_THRESHOLD=0.18

# Required graph persistence
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Frontend origins permitted to call this API. Add other local ports if needed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
